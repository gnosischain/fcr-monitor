# Execution-layer RPC endpoints. Each must be the EL paired with the named
# consensus client -- `safe` and `finalized` are set by that CL over the Engine
# API, so a shared or third-party endpoint makes the comparison meaningless.
NIMBUS_EL_RPC=http://nimbus-el:8545
LODESTAR_EL_RPC=http://lodestar-el:8545

# Consensus client versions shown on each card. These cannot be read over the
# execution RPC (it only reports the EL), so keep them in step with what the
# nodes actually run. The release link is derived from the version.
# NIMBUS_CL_VERSION=v26.7.0
# LODESTAR_CL_VERSION=v1.44.0
# NIMBUS_CL_RELEASE_URL=      # override only if the derived link is wrong
# LODESTAR_CL_RELEASE_URL=

# Grafana admin login (http://127.0.0.1:3001)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# --- optional tuning -------------------------------------------------------
# POLL_INTERVAL_MS=12000
# RPC_TIMEOUT_MS=5000
# MAX_WALK_BLOCKS=96
# EPOCHS_SHOWN=4
# REORG_HISTORY=500

# --- chain parameters (mainnet defaults) -----------------------------------
# GENESIS_TIME=1606824023
# SLOT_SECONDS=12
# SLOTS_PER_EPOCH=32
